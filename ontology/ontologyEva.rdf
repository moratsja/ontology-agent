    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#AdultPerson -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#AdultPerson">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasAge"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#AnxietySymptom -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#AnxietySymptom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Symptom"/>
    </owl:Class>
    


