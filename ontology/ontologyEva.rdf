    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#ReservedPerson -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#ReservedPerson">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCharacterTrait"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#reserved"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasBehaviour"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#nonTalkative"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Result -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Result">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#resultFor"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Player"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Team"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#resultOfMatch"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Match"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


