    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#BloodPressureHealthCondition -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#BloodPressureHealthCondition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#HealthCondition"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#DeficiencyHealthCondition"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#MetabolicHealthCondition"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Book -->

