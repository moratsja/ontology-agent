    </owl:Class>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CalenderSeason -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CalenderSeason">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#TimePeriod"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CapitalCity -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CapitalCity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#City"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isCapitalOf"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#City"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CharacterTrait -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CharacterTrait"/>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#City -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#City">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasFamousFood"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Food"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasLandmark"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Landmark"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isCityOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Company -->

    <owl:Class rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Company">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasHeadquarterIn"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#operatesIn"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Industry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#produces"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CompanyOutput"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasNumberOfEmployees"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                            </rdf:Description>
