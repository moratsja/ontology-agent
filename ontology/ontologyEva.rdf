<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#"
     xml:base="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:projectOntology="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#appearsIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#appearsIn">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#FictionalCharacter"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#MediaContent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#belongsToInternationalOrganization -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#belongsToInternationalOrganization">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#InternationalOrganization"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#belongsToTeam -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#belongsToTeam">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasPlayer"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Player"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Team"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#cannotEat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#cannotEat">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Food"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasAllergy"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isIngredientOf"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#causesSymptom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#causesSymptom">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Disease"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#HealthCondition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Symptom"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#collaboratesWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#collaboratesWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Company"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Company"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#competesIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#competesIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCompetitor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Team"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Match"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#follows -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#follows">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#precedes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Event"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Event"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasAllergy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasAllergy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isAllergyOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Ingredient"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasBehaviour -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasBehaviour">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Behaviour"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasBorderWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasBorderWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCapital -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCapital">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCity"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isCapitalOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CapitalCity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCharacterTrait -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCharacterTrait">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CharacterTrait"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCity">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isCityOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#City"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCompetitor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCompetitor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Match"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Team"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCondition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCondition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#HealthCondition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCountryOfOrigin -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCountryOfOrigin">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasDisease -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasDisease">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Disease"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasEpisode -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasEpisode">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isEpisodeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#TVSeason"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#TVEpisode"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasFamousFood -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasFamousFood">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Food"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#MediaContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Genre"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasHeadOfState -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasHeadOfState">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isHeadOfStateOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#HeadOfStatePerson"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasHeadquarterIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasHeadquarterIn">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasLocationIn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Company"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasIngredient">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isIngredientOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Food"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Ingredient"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasLandmark -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasLandmark">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Landmark"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasLocationIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasLocationIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Company"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasOccupation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasOccupation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isPerformedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Occupation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasOfficialLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasOfficialLanguage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Language"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasParticipant -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasParticipant">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#takesPartIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Event"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasPartnershipWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasPartnershipWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Company"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Company"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasPlayer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasPlayer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Team"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Player"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasReview -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasReview">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isReviewOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Company"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#CompanyOutput"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#MediaContent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Review"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasRitual -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasRitual">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Competition"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Ritual"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasSeason -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasSeason">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#isSeasonOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#TVSeries"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#TVSeason"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasSymptomPerson -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasSymptomPerson">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Symptom"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasTeam -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasTeam">
